# Keep your existing Supabase values in .env.local. Do not commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: a separately hosted, authenticated studio portal URL.
# Leave empty for local development: /portal opens 127.0.0.1:4173 on this computer.
# Live builds require an HTTPS URL; they never redirect visitors to localhost.
RENDERLINE_PORTAL_URL=

# Used by the local launcher only; relative paths resolve from next-app.
# The portal now lives beside next-app inside the website repository.
RENDERLINE_PORTAL_DIRECTORY=../studio-portal
